load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "mull-reporter",
    srcs = [
        "init_cli.rs",
        "mull-reporter.rs",
        "plugins.rs",
        "reporting.rs",
    ],
    crate_root = "mull-reporter.rs",
    rustc_env_files = ["//infrastructure:version.env"],
    stamp = -1,
    visibility = ["//visibility:public"],
    deps = [
        "//rust/mull-core",
        "//rust/mull-reporters",
        "//rust/mull-state",
        "@crates//:clap",
        "@crates//:serde-saphyr",
    ],
)

rust_binary(
    name = "mull-runner",
    srcs = [
        "dynamic_libraries.rs",
        "init_cli.rs",
        "mull-runner.rs",
        "mutant_extractor.rs",
        "plugins.rs",
        "reporting.rs",
        "runner.rs",
    ],
    crate_root = "mull-runner.rs",
    proc_macro_deps = [
        "@crates//:indoc",
    ],
    rustc_env_files = ["//infrastructure:version.env"],
    stamp = -1,
    visibility = ["//visibility:public"],
    deps = [
        "//rust/mull-core",
        "//rust/mull-filters",
        "//rust/mull-reporters",
        "//rust/mull-state",
        "//rust/mull-tasks",
        "@crates//:clap",
        "@crates//:libc",
        "@crates//:object",
        "@crates//:serde-saphyr",
        "@crates//:wait-timeout",
    ],
)

rust_test(
    name = "runner-tests",
    size = "small",
    srcs = [
        "dynamic_libraries.rs",
        "init_cli.rs",
        "mull-runner.rs",
        "mutant_extractor.rs",
        "plugins.rs",
        "reporting.rs",
        "runner.rs",
    ],
    crate_root = "mull-runner.rs",
    proc_macro_deps = [
        "@crates//:indoc",
    ],
    rustc_env = {
        "MULL_VERSION": "0.0.0-test",
    },
    deps = [
        "//rust/mull-core",
        "//rust/mull-filters",
        "//rust/mull-reporters",
        "//rust/mull-state",
        "//rust/mull-tasks",
        "@crates//:clap",
        "@crates//:libc",
        "@crates//:object",
        "@crates//:serde-saphyr",
        "@crates//:wait-timeout",
    ],
)
