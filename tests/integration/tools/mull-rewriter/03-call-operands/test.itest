The IR frontend replaces just a call, its object and arguments are still evaluated. The patches and
the rewritten program keep them as well. Every mutant is listed in code.cpp under its line.

RUN: rm -rf %S/Output && mkdir -p %S/Output/sandbox
RUN: cp %S/code.cpp %S/tests.cpp %S/mull.yml %S/Output/sandbox/
RUN: cd %S/Output/sandbox && %clang_cxx %sysroot -O0 -g -grecord-command-line %pass_mull_ir_frontend -c code.cpp -o %S/Output/code.o
RUN: cd %S/Output/sandbox && %clang_cxx %sysroot -O0 -c tests.cpp -o %S/Output/tests.o
RUN: %clang_cxx %sysroot %S/Output/code.o %S/Output/tests.o -o %S/Output/ir.exe

RUN: cd %S/Output/sandbox && %mull_runner --dry-run --allow-surviving --reporters SQLite --report-dir %S/Output --report-name dry %S/Output/ir.exe
RUN: echo '[{"directory": "%S/Output/sandbox", "file": "code.cpp", "command": "%clang_cxx %sysroot -c code.cpp"}]' > %S/Output/sandbox/compile_commands.json
RUN: %mull_rewriter --report %S/Output/dry.sqlite -p %S/Output/sandbox --root %S/Output/sandbox --output-dir %S/Output/rewritten | %filecheck %s --check-prefix=REWRITER
REWRITER-NOT: Not rewritten
REWRITER: Rewrote 13 of 13 mutants in 1 files
RUN: %clang_cxx %sysroot -O0 %S/Output/rewritten/code.cpp %S/Output/tests.o -o %S/Output/rewritten.exe

The operands stay in front of the replacement, as discarded expressions
RUN: %filecheck %s --check-prefix=TEXT < %S/Output/rewritten/code.cpp
TEXT: (__mull_on(MULL_ID_{{[0-9]+}}) ? ((void)((__mull_on({{.*}} : (advance()))), (void)0) : (ignore(
TEXT: (__mull_on(MULL_ID_{{[0-9]+}}) ? ((void)(fill(&value)), (bool)(true)) : __mull_on(MULL_ID_{{[0-9]+}}) ? ((void)(fill(&value)), (bool)(false)) : (present(fill(&value))))
TEXT: (__mull_on(MULL_ID_{{[0-9]+}}) ? ((void)(next()), (int)(42)) : __mull_on(MULL_ID_{{[0-9]+}}) ? ((void)(next()), (int)(0)) : (next().get()))
TEXT: (__mull_on(MULL_ID_{{[0-9]+}}) ? ((void)(n), (void)0) : (ignore(n)))
TEXT: (__mull_on(MULL_ID_{{[0-9]+}}) ? ((void)((__mull_on({{.*}} : (advance()))), (void)(1), (void)0) : (take({

The patches keep them too
RUN: cd %S/Output/sandbox && %mull_runner -allow-surviving -minimum-timeout 2000 -reporters=Patches --report-dir %S/Output/patches %S/Output/ir.exe
RUN: cat %S/Output/patches/*/*.patch | %filecheck %s --check-prefix=PATCH
PATCH-DAG: +  (void)(advance());
PATCH-DAG: +  return ((void)(fill(&value)), true) ? value : -1;
PATCH-DAG: +  return ((void)(fill(&value)), false) ? value : -1;
PATCH-DAG: +  return ((void)(next()), 42) > 0 ? position - start : -1;
PATCH-DAG: +  return ((void)(next()), 0) > 0 ? position - start : -1;
PATCH-DAG: +  (void)(n);
PATCH-DAG: +  ((void)(advance()), (void)(1));

RUN: cd %S/Output/sandbox && %mull_runner -allow-surviving -minimum-timeout 2000 -reporters=IDE -ide-reporter-show-killed %S/Output/ir.exe | %filecheck %S/code.cpp --implicit-check-not=warning:
RUN: cd %S/Output/sandbox && %mull_runner -allow-surviving -minimum-timeout 2000 -reporters=IDE -ide-reporter-show-killed %S/Output/rewritten.exe | %filecheck %S/code.cpp --implicit-check-not=warning:
