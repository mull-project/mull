Known bug, BUGS.md 5: mutants in a macro argument end at 0:0, no patch and no rewrite for them
XFAIL: *

RUN: rm -rf %S/Output && mkdir -p %S/Output/sandbox
RUN: cp %S/main.cpp %S/mull.yml %S/Output/sandbox/
RUN: cd %S/Output/sandbox && %clang_cxx %sysroot -O0 -g -grecord-command-line %pass_mull_ir_frontend main.cpp -o %S/Output/ir.exe
RUN: cd %S/Output/sandbox && %mull_runner --dry-run --allow-surviving --reporters SQLite --report-dir %S/Output --report-name dry %S/Output/ir.exe
RUN: %sqlite3 %S/Output/dry.sqlite "SELECT 'MUTANT', mutator, line_number || ':' || column_number || '-' || end_line_number || ':' || end_column_number FROM mutant ORDER BY column_number;" | %filecheck %s
CHECK: MUTANT|cxx_add_to_sub|3:21-3:22
CHECK-NEXT: MUTANT|cxx_eq_to_ne|3:25-3:27
