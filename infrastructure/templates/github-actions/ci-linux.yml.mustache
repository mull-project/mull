{{=[[ ]]=}}name: [[ OS_NAME ]] [[OS_VERSION]] ([[OS_ARCH]]) CI
env:
  CLOUDSMITH_API_KEY: ${{ secrets.CLOUDSMITH_API_KEY }}
  GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
on:
  push:
    branches: ["main"]
    tags: ["**"]
  pull_request:
    branches: ["main"]
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
jobs:
  # mull-runner/mull-reporter don't depend on LLVM; any of the CI images can build them
  tools:
    runs-on: [[ OS_RUNNER ]]
    timeout-minutes: 30
    name: [[ OS_NAME ]] [[OS_VERSION]] - tools
    steps:
      - uses: actions/checkout@v7
      - uses: ./.github/actions/detect-package-metadata
      - uses: ./.github/actions/setup-bazel-cache
        with:
          BUILDBUDDY_API_KEY: ${{ secrets.BUILDBUDDY_API_KEY }}
          PLATFORM: [[ OS_NAME_LOWER ]]-[[OS_VERSION]]-[[OS_ARCH]]
      - uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: ${{ github.repository_owner }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Build and package
        uses: devcontainers/ci@v0.3
        with:
          imageName: ghcr.io/mull-project/internal-[[ OS_NAME_LOWER ]]-[[OS_ARCH]]_[[OS_VERSION]]-llvm-[[TOOLS_LLVM_VERSION]]-ci
          configFile: ./.devcontainer/[[ OS_NAME_LOWER ]]_[[OS_VERSION]]-llvm-[[TOOLS_LLVM_VERSION]]/devcontainer.json
          runCmd: |
            set -e
            mkdir -p packages
            bazel build //:mull_tools_packages --stamp
            mv -v bazel-bin/Mull-*.[[PACKAGE_EXTENSION]] packages/
      - name: Publish package
        uses: devcontainers/ci@v0.3
        if: env.CLOUDSMITH_API_KEY != null
        with:
          imageName: ghcr.io/mull-project/internal-[[ OS_NAME_LOWER ]]-[[OS_ARCH]]_[[OS_VERSION]]-llvm-[[TOOLS_LLVM_VERSION]]-ci
          configFile: ./.devcontainer/[[ OS_NAME_LOWER ]]_[[OS_VERSION]]-llvm-[[TOOLS_LLVM_VERSION]]/devcontainer.json
          push: never
          env: CLOUDSMITH_API_KEY
          runCmd: |
            bazel run publish_tools --stamp && exit 0

            max_attempts=3
            attempt=1
            until [ "$attempt" -ge "$max_attempts" ]
            do
              echo "Attempt $attempt failed. Retrying..."
              attempt=$((attempt+1))
              bazel run publish_tools --stamp && exit 0
            done
            echo "All $max_attempts attempts failed."
            exit 1
      - name: Move package
        run: |
          mkdir -p /tmp/packages
          sudo mv -v packages/Mull-*.[[PACKAGE_EXTENSION]] /tmp/packages/
      - uses: ./.github/actions/attach-package
        with:
          GH_API_KEY: ${{ secrets.GITHUB_TOKEN }}
  build-and-test:
    # mull-N packages depend on the exact mull version, so publish them only after it
    needs: [tools]
    if: ${{ !cancelled() }}
    runs-on: [[ OS_RUNNER ]]
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        LLVM_VERSION: [[LLVM_VERSIONS]]
    name: [[ OS_NAME ]] [[OS_VERSION]] - LLVM ${{ matrix.LLVM_VERSION }}
    steps:
      - uses: actions/checkout@v7
      - uses: ./.github/actions/detect-package-metadata
      - uses: ./.github/actions/setup-bazel-cache
        with:
          BUILDBUDDY_API_KEY: ${{ secrets.BUILDBUDDY_API_KEY }}
          PLATFORM: [[ OS_NAME_LOWER ]]-[[OS_VERSION]]-[[OS_ARCH]]
      - uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: ${{ github.repository_owner }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Build, test, package
        uses: devcontainers/ci@v0.3
        with:
          imageName: ghcr.io/mull-project/internal-[[ OS_NAME_LOWER ]]-[[OS_ARCH]]_[[OS_VERSION]]-llvm-${{ matrix.LLVM_VERSION }}-ci
          configFile: ./.devcontainer/[[ OS_NAME_LOWER ]]_[[OS_VERSION]]-llvm-${{ matrix.LLVM_VERSION }}/devcontainer.json
          runCmd: |
            set -e
            mkdir -p packages
            bazel test //... || { cp -RL bazel-testlogs ci-testlogs; exit 1; }
            bazel build //:mull_llvm_packages --stamp
            mv -v bazel-bin/Mull-*.[[PACKAGE_EXTENSION]] packages/
      - name: Upload test logs
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: testlogs-[[ OS_NAME_LOWER ]]-[[OS_VERSION]]-[[OS_ARCH]]-llvm-${{ matrix.LLVM_VERSION }}
          path: ci-testlogs/
          if-no-files-found: ignore
          retention-days: 14
      - name: Publish package
        uses: devcontainers/ci@v0.3
        if: env.CLOUDSMITH_API_KEY != null && needs.tools.result == 'success'
        with:
          imageName: ghcr.io/mull-project/internal-[[ OS_NAME_LOWER ]]-[[OS_ARCH]]_[[OS_VERSION]]-llvm-${{ matrix.LLVM_VERSION }}-ci
          configFile: ./.devcontainer/[[ OS_NAME_LOWER ]]_[[OS_VERSION]]-llvm-${{ matrix.LLVM_VERSION }}/devcontainer.json
          push: never
          env: CLOUDSMITH_API_KEY
          runCmd: |
            bazel run publish --stamp && exit 0

            max_attempts=3
            attempt=1
            until [ "$attempt" -ge "$max_attempts" ]
            do
              echo "Attempt $attempt failed. Retrying..."
              attempt=$((attempt+1))
              bazel run publish --stamp && exit 0
            done
            echo "All $max_attempts attempts failed."
            exit 1
      - name: Move package
        run: |
          mkdir -p /tmp/packages
          sudo mv -v packages/Mull-*.[[PACKAGE_EXTENSION]] /tmp/packages/
      - uses: ./.github/actions/attach-package
        with:
          GH_API_KEY: ${{ secrets.GITHUB_TOKEN }}
  smoke-test:
    needs: [build-and-test]
    if: ${{ !cancelled() && needs.build-and-test.result == 'success' }}
    runs-on: [[ OS_RUNNER ]]
    name: Smoke test
    container:
      image: [[BASE_IMAGE]]
    steps:
      - name: Determine Cloudsmith repo
        id: metadata
        run: |
          if [ "${{ github.event_name }}" = "pull_request" ]; then
            echo "cs_repo=testing" >> $GITHUB_OUTPUT
          elif echo "${{ github.ref }}" | grep -q "^refs/tags/"; then
            echo "cs_repo=stable" >> $GITHUB_OUTPUT
          else
            echo "cs_repo=nightly" >> $GITHUB_OUTPUT
          fi
      - name: Install prerequisites
        run: [[&PRE_INSTALL_CMD]]
      - name: Setup Cloudsmith repo
        run: |
          curl -1sLf 'https://dl.cloudsmith.io/public/mull-project/mull-${{ steps.metadata.outputs.cs_repo }}/[[CLOUDSMITH_SETUP_SCRIPT]]' | bash
      - name: Install and test all mull packages
        run: |
          [[INSTALL_CMD]] mull
          runner_version=$(mull-runner --version)
          echo "$runner_version"
          if echo "$runner_version" | grep -q '{STABLE_'; then
            echo "ERROR: mull-runner contains unexpanded stamp variable"
            exit 1
          fi

          reporter_version=$(mull-reporter --version)
          echo "$reporter_version"
          if echo "$reporter_version" | grep -q '{STABLE_'; then
            echo "ERROR: mull-reporter contains unexpanded stamp variable"
            exit 1
          fi

          for version in [[&LLVM_VERSIONS_SPACE_SEPARATED]]; do
            echo "=== Testing LLVM $version ==="
            [[INSTALL_CMD]] mull-$version

            plugins=$(mull-runner --version)
            echo "$plugins"
            if ! echo "$plugins" | grep -q "mull-ir-frontend-$version (mull [0-9]"; then
              echo "ERROR: mull-runner does not list a stamped mull-ir-frontend-$version"
              exit 1
            fi

            # Deprecated versioned names, kept as symlinks
            mull-runner-$version --version
            mull-reporter-$version --version
          done
