common --test_output=errors
common --remote_cache_compression

# Treat external headers (LLVM, clang, etc.) as system headers to silence their warnings
common --features=external_include_paths

# Hermetic Rust builds: don't inherit shell environment in cargo build scripts
common --@rules_rust//cargo/settings:use_default_shell_env=False

# Workspace status for version stamping
build --workspace_status_command=infrastructure/workspace_status.sh

try-import .bazel.buildbuddy.rc
try-import .bazel.compilation_mode.bazelrc
try-import .bazel.build_salt.bazelrc
try-import .bazel.debug.bazelrc
